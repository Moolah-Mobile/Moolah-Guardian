<component name="ProjectRunConfigurationManager">
  <!-- Shared Android Studio run configuration. The app reads its keys from config/prod.json at build time
       (see lib/helper/env.dart); without this flag it opens on "This version can't start".
       Same as the "moolah" configuration in .vscode/launch.json. -->
  <configuration default="false" name="moolah" type="FlutterRunConfigurationType" factoryName="Flutter">
    <option name="additionalArgs" value="--dart-define-from-file=config/prod.json" />
    <option name="filePath" value="$PROJECT_DIR$/lib/main.dart" />
    <method v="2" />
  </configuration>
</component>
